# ---- Vercel environment variables (add these in Project → Settings → Environment Variables) ----

# The Google Sheet ID (from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit)
SHEET_ID=12CKIXn5AtHlVgJ9JB1Co7bADeFaphcXYgq59dgZk8Kk

# The service-account JSON key. Paste either the raw JSON (one line) OR its base64 encoding.
# Get it from Google Cloud → IAM & Admin → Service Accounts → Keys → Add key (JSON).
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"vnls-dashboard@your-project.iam.gserviceaccount.com",...}

# Optional: name of the tab used as the data bridge (auto-created). Defaults to "Dashboard".
DASHBOARD_TAB=Dashboard

# Optional shared secret. If set, the dashboard must send the same value (CONFIG.apiToken
# in index.html). Soft guard only — see README for hard access control.
API_SECRET=
